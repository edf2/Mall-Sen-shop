# 环境变量示例文件（复制为 .env 后按需修改）
# cp .env.example .env

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mall-sen-shop
DB_USERNAME=root
DB_PASSWORD=<你的MySQL密码>

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<你的RabbitMQ用户名>
RABBITMQ_PASSWORD=<你的RabbitMQ密码>

# JWT 签名密钥（64 位 hex = 32 字节），用 `openssl rand -hex 32` 生成后填入
JWT_ADMIN_SECRET_KEY=<生成 64 位 hex>
JWT_USER_SECRET_KEY=<生成 64 位 hex>

# 智能体服务间共享密钥，必须与 Python 侧 mall-sen-shop-AI/.env 的 AGENT_API_KEY 完全一致
AGENT_API_KEY=<生成 32 位以上强随机串>

# 模拟支付回调令牌（/notify/mock/paySuccess 需要）
SKY_PAY_MOCK_TOKEN=<生成强随机串>

# 阿里云 OSS（到阿里云 RAM 控制台获取）
ALIOSS_ACCESS_KEY_ID=<你的AccessKeyId>
ALIOSS_ACCESS_KEY_SECRET=<你的AccessKeySecret>

# 微信小程序（到微信公众平台获取）
WECHAT_APPID=<你的微信小程序AppID>
WECHAT_SECRET=<你的微信小程序Secret>

# 百度地图（到百度地图开放平台获取）
BAIDU_AK=<你的百度地图AK>
